<Window x:Class="WordLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordLens" Width="980" Height="640" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI" Foreground="{StaticResource TextMain}" UseLayoutRounding="True">
    <!-- Своя шапка вместо стандартной рамки Windows; тень и скруглённые углы при этом остаются -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ===== Боковое меню ===== -->
        <Border Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22,14,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,30">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentGradient}">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource Accent2}" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <TextBlock Text="W" FontSize="19" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WordLens" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="английский на лету" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#0FFFFFFF" CornerRadius="10" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusLabel" Text="Работает" FontSize="12.5" Margin="9,0,0,0"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Главная"
                                 GroupName="Nav" IsChecked="True" Checked="OnNavChanged"/>
                    <RadioButton x:Name="NavWords" Style="{StaticResource NavButton}" Tag="&#xE82D;" Content="Мой словарь"
                                 GroupName="Nav" Checked="OnNavChanged"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Настройки"
                                 GroupName="Nav" Checked="OnNavChanged"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Правая часть ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- мягкое свечение в углу -->
            <Ellipse Grid.RowSpan="2" Width="620" Height="420" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-220,-220,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#389B6BFF" Offset="0"/>
                        <GradientStop Color="#009B6BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconGhostButton}" Content="&#xE921;" ToolTip="Свернуть" Click="OnMinimize"/>
                <Button Style="{StaticResource IconGhostButton}" Content="&#xE8BB;" ToolTip="Закрыть окно — WordLens продолжит работать возле часов" Click="OnClose"/>
            </StackPanel>

            <!-- ===== Главная ===== -->
            <StackPanel x:Name="HomePage" Grid.Row="1" Margin="34,4,34,28">
                <TextBlock Text="Наведи. Нажми. Запомни." Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Учи английский прямо в играх, видео и на сайтах — по одному слову за раз."
                           Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,6,0,22"/>

                <Border CornerRadius="16" Padding="1" Background="{StaticResource AccentGradient}">
                    <Border CornerRadius="15" Padding="26,22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A2140" Offset="0"/>
                                <GradientStop Color="#1D1733" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="12" Padding="14,8"
                                    Background="#14FFFFFF">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="HeroDot" Width="9" Height="9" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HeroStatus" Text="Готов к работе" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Наведи курсор на английское слово и нажми" FontSize="15" Foreground="#C9CED8"/>
                                <ItemsControl x:Name="HotkeyCaps" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Keycap}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Border>

                <UniformGrid Columns="3" Margin="-7,18,-7,0">
                    <Border Style="{StaticResource Card}" Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="Слов в словаре" Style="{StaticResource Hint}"/>
                            <TextBlock x:Name="StatTotal" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="За последние 7 дней" Style="{StaticResource Hint}"/>
                            <TextBlock x:Name="StatWeek" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="Сегодня" Style="{StaticResource Hint}"/>
                            <TextBlock x:Name="StatToday" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Foreground="{StaticResource AccentText}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Недавние слова" Style="{StaticResource CardTitle}" Margin="0,24,0,10"/>
                <TextBlock x:Name="RecentEmpty" Style="{StaticResource Hint}" FontSize="13.5"
                           Text="Пока пусто. Переведи слово и нажми звёздочку в окошке — оно появится здесь и в словаре."/>
                <ItemsControl x:Name="RecentWords" MaxHeight="130">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                    CornerRadius="18" Padding="14,7" Margin="0,0,8,8">
                                <TextBlock FontSize="13.5">
                                    <Run Text="{Binding Word, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="—" Foreground="{StaticResource TextMuted}"/>
                                    <Run Text="{Binding Translation, Mode=OneWay}" Foreground="{StaticResource AccentText}"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Словарь ===== -->
            <DockPanel x:Name="WordsPage" Grid.Row="1" Margin="34,4,20,24" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,14,18">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Выгрузить для Anki"
                            VerticalAlignment="Center" Click="OnExport"/>
                    <StackPanel>
                        <TextBlock Text="Мой словарь" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="WordsCount" Foreground="{StaticResource TextMuted}" FontSize="14" Margin="0,6,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,14,14">
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="40,10,12,10" TextChanged="OnSearchChanged"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource TextMuted}"
                               Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchHint" Text="Найти слово или перевод" FontSize="14" Foreground="{StaticResource TextMuted}"
                               Margin="42,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <Grid>
                    <TextBlock x:Name="WordsEmpty" Style="{StaticResource Hint}" FontSize="14" TextAlignment="Center" MaxWidth="400"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="WordCards" Margin="0,0,14,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CardRoot" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Orientation="Horizontal">
                                                <TextBlock Text="{Binding AddedText}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                                <Button x:Name="RemoveButton" Style="{StaticResource IconGhostButton}" Content="&#xE74D;" FontSize="13"
                                                        Width="32" Height="30" Margin="8,0,0,0" ToolTip="Убрать из словаря"
                                                        Visibility="Hidden" Click="OnRemoveWord"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{Binding Word, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding Transcription, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Translation}" FontSize="15" Foreground="{StaticResource AccentText}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Context}" Style="{StaticResource Hint}" FontStyle="Italic" Margin="0,7,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardRoot" Property="Background" Value="{StaticResource CardHoverBg}"/>
                                            <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- ===== Настройки ===== -->
            <StackPanel x:Name="SettingsPage" Grid.Row="1" Margin="34,4,34,28" Visibility="Collapsed">
                <TextBlock Text="Настройки" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ключ DeepSeek" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                                   Text="Это «мозг» переводчика. Получить: platform.deepseek.com → API keys. Пары долларов на счёте хватит на месяцы."/>
                        <TextBox x:Name="ApiKeyBox" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <DockPanel>
                        <TextBox x:Name="HotkeyBox" DockPanel.Dock="Right" Style="{StaticResource DarkTextBox}" Width="190"
                                 IsReadOnly="True" TextAlignment="Center" FontWeight="SemiBold" FontSize="15" Cursor="Hand"
                                 VerticalAlignment="Center" CaretBrush="Transparent"
                                 PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"/>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Клавиша перевода" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="Кликни в поле справа и нажми клавишу или сочетание. Если в игре она уже занята, выбери другую."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <DockPanel>
                        <CheckBox x:Name="AutostartSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Запускать вместе с Windows" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="WordLens будет тихо сидеть возле часов и ждать нажатия клавиши."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DockPanel Margin="0,22,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Сохранить" Click="OnSave"/>
                    <TextBlock x:Name="SaveStatus" DockPanel.Dock="Right" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,18,0"
                               TextWrapping="Wrap" MaxWidth="440"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
