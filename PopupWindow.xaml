<Window x:Class="WordLens.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" Left="-10000" Top="-10000"
        FontFamily="Segoe UI" Foreground="#E8EAF0">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#9AA3B2"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Margin="10" Padding="16,12,12,14" CornerRadius="10" MinWidth="230" MaxWidth="400"
            Background="#F51B1D23" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel>
                <StackPanel x:Name="Buttons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                    <Button x:Name="SpeakButton" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Послушать" Click="OnSpeak"/>
                    <Button x:Name="StarButton" Style="{StaticResource IconButton}" Content="&#xE734;" ToolTip="В мой словарь" Click="OnStar"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run x:Name="WordRun" FontSize="20" FontWeight="SemiBold"/>
                    <Run x:Name="TranscriptionRun" FontSize="13" Foreground="#9AA3B2"/>
                </TextBlock>
            </DockPanel>

            <TextBlock x:Name="PartOfSpeechText" FontSize="12" FontStyle="Italic" Foreground="#9AA3B2" Margin="0,1,0,0"/>
            <TextBlock x:Name="TranslationText" FontSize="19" Foreground="#7CC4FF" TextWrapping="Wrap" Margin="0,8,4,0"/>
            <TextBlock x:Name="OtherText" FontSize="13" Foreground="#9AA3B2" TextWrapping="Wrap" Margin="0,3,4,0"/>

            <Border x:Name="PhraseBox" Background="#1AFFFFFF" CornerRadius="6" Padding="10,7" Margin="0,10,4,0">
                <TextBlock TextWrapping="Wrap" FontSize="13">
                    <Run Text="Здесь это часть выражения" Foreground="#9AA3B2"/>
                    <LineBreak/>
                    <Run x:Name="PhraseRun" FontWeight="SemiBold"/>
                    <Run x:Name="PhraseTranslationRun" Foreground="#7CC4FF"/>
                </TextBlock>
            </Border>

            <!-- Разбор фразы: самые полезные слова и выражения из неё -->
            <ItemsControl x:Name="KeyWordsList" Margin="0,12,4,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,2">
                            <Run Text="{Binding English, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="—" Foreground="#9AA3B2"/>
                            <Run Text="{Binding Russian, Mode=OneWay}" Foreground="#7CC4FF"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="NoteText" FontSize="13" Foreground="#C9CED8" TextWrapping="Wrap" Margin="0,10,4,0"/>
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="#9AA3B2" TextWrapping="Wrap" Margin="0,6,4,0"/>
        </StackPanel>
    </Border>
</Window>
