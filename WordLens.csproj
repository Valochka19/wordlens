<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>WordLens</RootNamespace>
    <!-- WinForms просит настраивать DPI через свой API, но приложение у нас WPF — манифест здесь правильный способ -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms нужен только для иконки в трее и снимка экрана; его using'и конфликтуют с WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
    <!-- Старые окна настроек и словаря, заменены на MainWindow. Лежат на память, в сборку не идут. -->
    <Compile Remove="_old\**" />
    <Page Remove="_old\**" />
    <None Remove="_old\**" />
  </ItemGroup>

</Project>
